# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.wpress
*.sql.gz
*.sql

# original backup -- never commit them (size, and some of the backup's
# raw plugin/media tree is not something we want duplicated in git).

# Local runtime admin settings (email recipient, etc.) -- environment
# specific, regenerated by using the /admin panel.
/data/admin-settings.json

# runtime uploads from the PHP API host
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# catalog seed data for the backend database
!backend/db/init/*.sql

backend/backups/
