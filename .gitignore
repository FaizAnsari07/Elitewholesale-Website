# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!wordpress/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# WordPress migration source backups (large, not part of the app)
*.wpress
*.sql.gz
*.sql

# Local WordPress backend: vendored plugin/theme code, media, and the
# MySQL data volume are all regenerated by wordpress/setup.sh from the
# original backup -- never commit them (size, and some of the backup's
# raw plugin/media tree is not something we want duplicated in git).
wordpress/wp-content/
wordpress/db-init/

# Local runtime admin settings (email recipient, etc.) -- environment
# specific, regenerated by using the /admin panel.
/data/admin-settings.json

# runtime uploads from the PHP API host
wordpress/api/public/uploads/*
!wordpress/api/public/uploads/.gitkeep
