# Copy this file to .env.local for local development.
# WPGraphQL endpoint of the local WordPress admin backend (see wordpress/README.md).
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql

# WooCommerce REST API (used by the /admin panel for writes -- WPGraphQL
# doesn't support Application Password auth, REST does). Generate via:
#   docker compose run --rm wpcli wp user application-password create localadmin "nextjs-admin" --porcelain --allow-root
WORDPRESS_API_URL=http://localhost:8080/wp-json
WORDPRESS_APP_USER=localadmin
WORDPRESS_APP_PASSWORD=change-me

# /admin panel login (separate from the WordPress application password above --
# this just gates access to the Next.js admin UI itself).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
