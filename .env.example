# Used by `docker compose up --build` (copy to .env).
DB_ROOT_PASSWORD=change-me
DB_USER=catalog_app
DB_PASSWORD=change-me
CATALOG_API_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32

# Website only (Vercel, Dokploy app, `npm run dev`): the address of the PHP API.
# Under `docker compose` this is set for you (http://api). It must be set at BUILD
# time and at run time; production never falls back to a default.
#CATALOG_API_URL=http://localhost:8080
