# Base URL of the PHP catalog API (wordpress/api, run via docker compose).
CATALOG_API_URL=http://localhost:8080
# Must equal CATALOG_API_KEY in wordpress/.env. Used for admin writes only.
CATALOG_API_KEY=change-me

# /admin panel login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
